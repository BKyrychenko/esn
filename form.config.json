{
  "site": {
    "title": "Безопасное заполнение таблицы",
    "description": "Форма отправляет данные на защищённый сервер, а сервер уже записывает их в Google Sheet."
  },
  "successMessage": "Данные успешно отправлены.",
  "fields": [
    {
      "name": "fullName",
      "sheetHeader": "ФИО",
      "label": "ФИО",
      "type": "text",
      "required": true,
      "placeholder": "Иван Иванов",
      "maxLength": 120
    },
    {
      "name": "phone",
      "sheetHeader": "Телефон",
      "label": "Телефон",
      "type": "tel",
      "required": true,
      "placeholder": "+32 470 00 00 00",
      "maxLength": 30,
      "pattern": "^[0-9+()\\-\\s]{7,30}$"
    },
    {
      "name": "email",
      "sheetHeader": "Email",
      "label": "Email",
      "type": "email",
      "required": false,
      "placeholder": "name@example.com",
      "maxLength": 120
    },
    {
      "name": "comment",
      "sheetHeader": "Комментарий",
      "label": "Комментарий",
      "type": "textarea",
      "required": false,
      "placeholder": "Введите комментарий",
      "maxLength": 1000
    }
  ]
}
